# GitHub token — SERVER-SIDE ONLY. Not prefixed with VITE_, so it never reaches
# the browser bundle; the SSR loader reads it from process.env on the server.
#
# Optional: raises the GitHub REST API rate limit used by the projects section
# (unauthenticated 60/h → authenticated 5000/h). The site works without it.
#
# In production, set this in your host's environment (e.g. Vercel project env),
# not in a committed file. For local dev, `export GITHUB_TOKEN=...` before
# `npm run dev` if you want it. Use a read-only token.
GITHUB_TOKEN=
